# CryptNote Worker — environment schema (varlock + baymutt).
#
# Safe to commit: names the baymutt environment the deploy token lives in, never the value. Read by
# `pnpm -F @cryptnote/worker-web run deploy`; local `wrangler dev` needs none of it.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@baymutt/varlock-plugin)
# @initBaymutt(key=$BAYMUTT_KEY)
# @setValuesBulk(baymuttLoad("fishball-ltd/cryptnote/worker-web/production"))
# ---

# Service account key in CI; unset locally when `BAYMUTT_KEY_FILE` is provided.
# @required=false
BAYMUTT_KEY=

# Cloudflare deploy token (Workers Scripts: Edit, D1: Edit, Account Settings: Read; Zone: Read,
# Workers Routes: Edit and SSL and Certificates: Edit pinned to the fsh.ba zone).
CLOUDFLARE_DEPLOY_TOKEN=
